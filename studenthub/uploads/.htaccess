# StudentHub poster uploads: never served directly and never executed (posters are delivered by poster.php)
Require all denied
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phar
Options -ExecCGI -Indexes

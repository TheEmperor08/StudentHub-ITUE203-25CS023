# Apache (XAMPP): the poster folder is never served directly – posters are delivered by poster.php only.
Require all denied
Options -Indexes -ExecCGI
# Even if access were allowed by mistake, nothing in this folder may run as PHP or as a script
<IfModule php_module>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps .cgi .pl .py .shtml
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar .pht .phps
<FilesMatch "\.(?i:php\d?|phtml|phar|pht|phps|cgi|pl|py|shtml|svg|html?)$">
    SetHandler none
    ForceType text/plain
</FilesMatch>
